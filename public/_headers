# Headers de seguridad y políticas de caché para Cloudflare Pages (TOTALHIIT PWA)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# El Service Worker nunca debe cachearse de forma inmutable para permitir auto-actualizaciones
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

# El manifiesto PWA
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# Manifiesto de versiones y APK para descargas directas (nunca cachear en CDN o navegador)
/version.json
  Cache-Control: public, max-age=0, must-revalidate, no-cache

/totalhiit.apk
  Cache-Control: public, max-age=0, must-revalidate, no-cache
  Content-Disposition: attachment; filename="totalhiit.apk"

# Assets versionados con hash (seguros para caché inmutable de 1 año)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
