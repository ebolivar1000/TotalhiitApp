# Headers de seguridad y políticas de caché para Cloudflare (TOTALHIIT PWA & APK)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *

# El Service Worker nunca debe cachearse de forma inmutable para permitir auto-actualizaciones
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache

# El manifiesto PWA
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Content-Type: application/manifest+json; charset=utf-8

# Manifiesto de versiones y APK para descargas directas (NUNCA cachear en CDN ni navegador)
/version.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Content-Type: application/json; charset=utf-8

/totalhiit.apk
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="totalhiit.apk"

# Assets versionados con hash (seguros para caché inmutable de 1 año)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
